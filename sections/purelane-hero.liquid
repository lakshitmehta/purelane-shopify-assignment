{% javascript %}
(() => {
  const initialized = new WeakSet();

  const initializeHero = (root) => {
    if (!root || initialized.has(root)) return;

    const stage = root.querySelector('.purelane-hero__stage');
    const slides = Array.from(root.querySelectorAll('.purelane-hero__slide'));
    const dots = Array.from(root.querySelectorAll('.purelane-hero__dot'));

    if (!stage || slides.length <= 1) {
      initialized.add(root);
      return;
    }

    initialized.add(root);

    let current = 0;
    let timer = null;
    let paused = false;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const speed = Math.max(
      1800,
      Number(root.dataset.autoplaySpeed || 3800)
    );

    const autoplayEnabled = root.dataset.autoplay === 'true';

    const setSlide = (index) => {
      current = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;

        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === current;

        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      stop();

      if (!autoplayEnabled || reducedMotion.matches || paused) return;

      timer = window.setInterval(() => {
        setSlide(current + 1);
      }, speed);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setSlide(Number(dot.dataset.slideTo || 0));
        start();
      });
    });

    stage.addEventListener('mouseenter', () => {
      paused = true;
      stop();
    });

    stage.addEventListener('mouseleave', () => {
      paused = false;
      start();
    });

    stage.addEventListener('focusin', () => {
      paused = true;
      stop();
    });

    stage.addEventListener('focusout', () => {
      paused = false;
      start();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });

    document.addEventListener('shopify:section:select', (event) => {
      if (event.target.contains(root)) {
        paused = true;
        stop();
      }
    });

    document.addEventListener('shopify:section:deselect', (event) => {
      if (event.target.contains(root)) {
        paused = false;
        start();
      }
    });

    setSlide(0);
    start();
  };

  const initializeAll = () => {
    document
      .querySelectorAll('.purelane-hero')
      .forEach(initializeHero);
  };

  initializeAll();

  document.addEventListener('shopify:section:load', (event) => {
    const hero = event.target.querySelector?.('.purelane-hero');

    if (hero) {
      initializeHero(hero);
    }
  });
})();
{% endjavascript %}

