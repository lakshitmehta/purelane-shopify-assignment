  }

  .purelane-hero__stage {
    height: clamp(300px, 44svh, 430px);
  }

  .purelane-hero__price-card {
    max-width: 58%;
    padding: 0.6rem 0.75rem;
    border-radius: 14px;
  }

  .purelane-hero__price-line strong {
    font-size: 2rem;
  }
}

@media screen and (max-width: 520px) {
  .purelane-hero__heading {
    font-size: clamp(4rem, 17vw, 5.5rem);
