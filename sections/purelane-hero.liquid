<section
  class="purelane-hero"
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  style="
    --pl-brand: {{ section.settings.brand_color }};
    --pl-brand-dark: {{ section.settings.brand_dark_color }};
    --pl-accent: {{ section.settings.accent_color }};
    --pl-paper: {{ section.settings.text_color }};
    --pl-surface: {{ section.settings.surface_color }};
  "
>
  <div class="purelane-hero__background" aria-hidden="true"></div>

  <div class="purelane-hero__inner">
    <div class="purelane-hero__content">

      <div class="purelane-hero__desktop-promises" aria-label="Product promises">
        {% assign promise_count = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'promise' and promise_count < 3 %}
            {% assign promise_count = promise_count | plus: 1 %}

            <div class="purelane-hero__promise" {{ block.shopify_attributes }}>
              <span class="purelane-hero__icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                    </svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                      <path d="m9 12 2.2 2.2L15.4 10"/>
                    </svg>
                  {% when 'circle' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="8.4"/>
                      <path d="M6.4 17.6 17.6 6.4"/>
                    </svg>
                {% endcase %}
              </span>

              <span class="purelane-hero__promise-text">
                {{ block.settings.text | escape | newline_to_br }}
              </span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="purelane-hero__copy">
        <h1 class="purelane-hero__heading">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <span>{{ section.settings.heading_line_2 | escape }}</span>
          <span class="purelane-hero__heading-accent">
            {{ section.settings.heading_highlight | escape }}
          </span>
        </h1>

        <div class="purelane-hero__rule" aria-hidden="true">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>

        <div class="purelane-hero__description">
          {{ section.settings.description | escape }}
        </div>

        <div class="purelane-hero__actions">
          {% if section.settings.primary_label != blank %}
            <a
              class="purelane-hero__button purelane-hero__button--primary"
              href="{{ section.settings.primary_link }}"
            >
              {{ section.settings.primary_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.secondary_label != blank %}
            <a
              class="purelane-hero__button purelane-hero__button--ghost"
              href="{{ section.settings.secondary_link }}"
            >
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>

        <div class="purelane-hero__mobile-promises" aria-label="Product promises">
          {% assign mobile_promise_count = 0 %}

          {% for block in section.blocks %}
            {% if block.type == 'promise' and mobile_promise_count < 3 %}
              {% assign mobile_promise_count = mobile_promise_count | plus: 1 %}

              <div class="purelane-hero__mobile-promise" {{ block.shopify_attributes }}>
                <span class="purelane-hero__mobile-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'leaf' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                      </svg>
                    {% when 'shield' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                        <path d="m9 12 2.2 2.2L15.4 10"/>
                      </svg>
                    {% when 'circle' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="8.4"/>
                        <path d="M6.4 17.6 17.6 6.4"/>
                      </svg>
                  {% endcase %}
                </span>

                <span>{{ block.settings.text | escape | newline_to_br }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="purelane-hero__product-area">
      <div
        class="purelane-hero__stage"
        role="region"
        aria-roledescription="carousel"
        aria-label="Purelane offers"
        tabindex="0"
      >
        {% assign offer_count = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'offer' and offer_count < 3 %}
            {% assign offer_count = offer_count | plus: 1 %}

            {% assign current_product = block.settings.price_product %}
            {% assign compare_total = 0 %}

            {% if block.settings.product_1 != blank %}
              {% assign compare_total = compare_total | plus: block.settings.product_1.price %}
            {% endif %}

            {% if block.settings.product_2 != blank %}
              {% assign compare_total = compare_total | plus: block.settings.product_2.price %}
            {% endif %}

            {% if block.settings.product_3 != blank %}
              {% assign compare_total = compare_total | plus: block.settings.product_3.price %}
            {% endif %}

            {% if current_product != blank and current_product.compare_at_price > current_product.price %}
              {% assign compare_total = current_product.compare_at_price %}
            {% endif %}

            {% assign current_price = 0 %}
            {% if current_product != blank %}
              {% assign current_price = current_product.price %}
            {% endif %}

            {% assign savings = compare_total | minus: current_price %}
            {% assign discount_percent = 0 %}

            {% if compare_total > current_price and compare_total > 0 %}
              {% assign discount_percent = savings | times: 100 | divided_by: compare_total %}
            {% endif %}

            {% case block.settings.product_count %}
              {% when '1' %}
                {% assign stage_class = 'is-one' %}
              {% when '2' %}
                {% assign stage_class = 'is-two' %}
              {% else %}
                {% assign stage_class = 'is-three' %}
            {% endcase %}

            <article
              class="purelane-hero__slide{% if offer_count == 1 %} is-active{% endif %}"
              data-slide-index="{{ offer_count | minus: 1 }}"
              aria-hidden="{% if offer_count == 1 %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div
                class="purelane-hero__products {{ stage_class }}"
                data-count="{{ block.settings.product_count }}"
              >
                {% if block.settings.product_1 != blank and block.settings.product_1.featured_image != blank %}
                  <div class="purelane-hero__product-image purelane-hero__product-image--one">
                    {{
                      block.settings.product_1.featured_image
                      | image_url: width: 720
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720',
                        alt: block.settings.product_1.title
                    }}
                  </div>
                {% endif %}

                {% if block.settings.product_2 != blank and block.settings.product_2.featured_image != blank %}
                  <div class="purelane-hero__product-image purelane-hero__product-image--two">
                    {{
                      block.settings.product_2.featured_image
                      | image_url: width: 720
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720',
                        alt: block.settings.product_2.title
                    }}
                  </div>
                {% endif %}

                {% if block.settings.product_3 != blank and block.settings.product_3.featured_image != blank %}
                  <div class="purelane-hero__product-image purelane-hero__product-image--three">
                    {{
                      block.settings.product_3.featured_image
                      | image_url: width: 720
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720',
                        alt: block.settings.product_3.title
                    }}
                  </div>
                {% endif %}

                {% if block.settings.product_1 == blank and block.settings.product_2 == blank and block.settings.product_3 == blank %}
                  <div class="purelane-hero__empty">
                    Select products in this offer
                  </div>
                {% endif %}
              </div>

              {% if current_product != blank %}
                <div class="purelane-hero__price-card">
                  <span class="purelane-hero__price-label">
                    {{ block.settings.label | escape }}
                  </span>

                  <div class="purelane-hero__price-line">
                    <strong>{{ current_price | money }}</strong>

                    {% if compare_total > current_price %}
                      <s>{{ compare_total | money }}</s>
                    {% endif %}
                  </div>

                  {% if savings > 0 %}
                    <span class="purelane-hero__price-badge">
                      {% if block.settings.show_percentage %}
                        {{ discount_percent }}% off
                      {% else %}
                        Save {{ savings | money }}
                      {% endif %}
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <div class="purelane-hero__dots" role="tablist" aria-label="Choose offer">
        {% assign dot_count = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'offer' and dot_count < 3 %}
            {% assign dot_count = dot_count | plus: 1 %}

            <button
              type="button"
              class="purelane-hero__dot{% if dot_count == 1 %} is-active{% endif %}"
              data-slide-to="{{ dot_count | minus: 1 }}"
              role="tab"
              aria-selected="{% if dot_count == 1 %}true{% else %}false{% endif %}"
              aria-label="Show offer {{ dot_count }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.purelane-hero {
  --pl-paper-muted: rgba(236, 230, 247, 0.74);
  --pl-paper-soft: rgba(236, 230, 247, 0.52);
  --pl-line: rgba(236, 230, 247, 0.22);
  --pl-ease: cubic-bezier(0.2, 0.7, 0.2, 1);

  position: relative;
  z-index: 1;
  min-height: min(860px, calc(100svh - 7rem));
  overflow: hidden;
  isolation: isolate;
  background: var(--pl-brand);
  color: var(--pl-paper);
}

.purelane-hero__background {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(circle at 78% 48%, rgba(75, 58, 143, 0.52), transparent 38%),
    linear-gradient(
      178deg,
      #1ea38d 0%,
      #0b8578 22%,
      #017069 48%,
      var(--pl-brand) 74%,
      var(--pl-brand-dark) 100%
    );
}

.purelane-hero__background::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      102deg,
      rgba(1, 45, 42, 0.68) 0%,
      rgba(1, 45, 42, 0.4) 30%,
      rgba(1, 45, 42, 0.1) 52%,
      transparent 66%
    );
}

.purelane-hero__inner {
  width: min(1180px, calc(100% - 36px));
  min-height: inherit;
  margin: 0 auto;
  padding: 6.25rem 0 2.125rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 560px);
  align-items: end;
  gap: 2rem;
}

.purelane-hero__content {
  position: relative;
  z-index: 2;
}

.purelane-hero__copy {
  max-width: 600px;
}

.purelane-hero__heading {
  margin: 0 0 1.25rem;
  color: var(--pl-surface);
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: clamp(4rem, 8.6vw, 7rem);
  font-weight: 800;
  line-height: 0.87;
  letter-spacing: -0.018em;
  text-transform: uppercase;
  text-shadow: 0 6px 40px rgba(2, 20, 19, 0.55);
}

.purelane-hero__heading span {
  display: block;
}

.purelane-hero__heading-accent {
  color: var(--pl-accent);
}

.purelane-hero__rule {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  width: min(270px, 100%);
  margin: 0 0 1.25rem;
}

.purelane-hero__rule i {
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, rgba(236, 230, 247, 0.44), transparent);
}

.purelane-hero__rule i:last-child {
  background: linear-gradient(90deg, rgba(236, 230, 247, 0.44), transparent);
}

.purelane-hero__rule svg {
  width: 1rem;
  height: 1rem;
  flex: 0 0 auto;
  color: var(--pl-accent);
}

.purelane-hero__description {
  max-width: 44ch;
  color: var(--pl-paper-muted);
  font-size: clamp(1.5rem, 1.35vw, 1.75rem);
  line-height: 1.62;
}

.purelane-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.625rem;
}

.purelane-hero__button {
  min-height: 4.8rem;
  padding: 1.2rem 1.7rem;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  font-family: var(--font-body-family, system-ui, sans-serif);
  font-size: 1.35rem;
  font-weight: 700;
  line-height: 1;
  transition:
    transform 0.25s ease,
    background-color 0.25s ease,
    border-color 0.25s ease;
}

.purelane-hero__button svg {
  width: 1.9rem;
  height: 1.9rem;
}

.purelane-hero__button:hover {
  transform: translateY(-2px);
}

.purelane-hero__button:focus-visible,
.purelane-hero__dot:focus-visible,
.purelane-hero__stage:focus-visible {
  outline: 2px solid var(--pl-accent);
  outline-offset: 3px;
}

.purelane-hero__button--primary {
  background: var(--pl-accent);
  color: #20132b;
}

.purelane-hero__button--ghost {
  border: 1px solid rgba(236, 230, 247, 0.35);
  background: rgba(236, 230, 247, 0.08);
  color: var(--pl-surface);
  backdrop-filter: blur(10px);
}

.purelane-hero__desktop-promises {
  position: absolute;
  top: 50%;
  right: 0;
  width: 96px;
  padding: 0.75rem 0.5rem;
  transform: translateY(-50%);
  border: 1px solid var(--pl-line);
  border-radius: 20px;
  background: rgba(236, 230, 247, 0.08);
  backdrop-filter: blur(18px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.24),
    0 20px 50px rgba(2, 20, 19, 0.24);
}

.purelane-hero__promise {
  padding: 0.7rem 0.2rem;
  text-align: center;
}

.purelane-hero__promise + .purelane-hero__promise {
  border-top: 1px solid rgba(236, 230, 247, 0.14);
}

.purelane-hero__icon,
.purelane-hero__mobile-icon {
  width: 38px;
  height: 38px;
  margin: 0 auto 0.5rem;
  border: 1px solid rgba(236, 230, 247, 0.22);
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(236, 230, 247, 0.1);
  color: var(--pl-accent);
}

.purelane-hero__icon svg,
.purelane-hero__mobile-icon svg {
  width: 19px;
  height: 19px;
}

.purelane-hero__promise-text {
  display: block;
  color: var(--pl-paper-muted);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  line-height: 1.34;
  text-transform: uppercase;
}

.purelane-hero__mobile-promises {
  display: none;
}

.purelane-hero__product-area {
  position: relative;
  z-index: 2;
  width: 100%;
  filter: drop-shadow(0 34px 54px rgba(2, 20, 19, 0.6));
}

.purelane-hero__stage {
  position: relative;
  width: 100%;
  height: clamp(380px, 74svh, 680px);
}

.purelane-hero__slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding-right: 2%;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.85s var(--pl-ease);
}

.purelane-hero__slide.is-active {
  opacity: 1;
  pointer-events: auto;
}

.purelane-hero__products {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.purelane-hero__product-image {
  position: relative;
  flex: 0 0 auto;
  opacity: 0;
  transform: translateY(28px) scale(0.94);
  transition:
    opacity 0.8s var(--pl-ease),
    transform 0.8s var(--pl-ease);
}

.purelane-hero__slide.is-active .purelane-hero__product-image {
  opacity: 1;
  transform: none;
}

.purelane-hero__product-image img {
  display: block;
  width: auto;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 26px 40px rgba(1, 22, 20, 0.66));
}

.purelane-hero__products.is-one .purelane-hero__product-image--one {
  height: 100%;
}

.purelane-hero__products.is-two .purelane-hero__product-image--one {
  height: 80%;
  margin-right: -8%;
  z-index: 1;
}

.purelane-hero__products.is-two .purelane-hero__product-image--two {
  height: 97%;
  z-index: 3;
}

.purelane-hero__products.is-three .purelane-hero__product-image--one {
  height: 75%;
  margin-right: -8%;
  z-index: 1;
}

.purelane-hero__products.is-three .purelane-hero__product-image--two {
  height: 79%;
  margin-left: -8%;
  z-index: 2;
  order: 3;
}

.purelane-hero__products.is-three .purelane-hero__product-image--three {
  height: 97%;
  z-index: 3;
  order: 2;
}

.purelane-hero__empty {
  width: min(320px, 80%);
  padding: 2rem;
  border: 1px dashed rgba(236, 230, 247, 0.3);
  border-radius: 20px;
  color: var(--pl-paper-muted);
  text-align: center;
  background: rgba(236, 230, 247, 0.08);
}

.purelane-hero__price-card {
  position: absolute;
  left: 0;
  bottom: 2%;
  z-index: 6;
  max-width: 52%;
  padding: 0.75rem 0.9rem;
  border: 1px solid rgba(236, 230, 247, 0.22);
  border-radius: 16px;
  background: rgba(236, 230, 247, 0.08);
  backdrop-filter: blur(18px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24);
  opacity: 0;
  transform: translateY(16px);
  transition:
    opacity 0.8s var(--pl-ease) 0.62s,
    transform 0.8s var(--pl-ease) 0.62s;
}

.purelane-hero__slide.is-active .purelane-hero__price-card {
  opacity: 1;
  transform: none;
}

.purelane-hero__price-label {
  display: block;
  color: var(--pl-accent);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.purelane-hero__price-line {
  display: flex;
  align-items: baseline;
  gap: 0.7rem;
  margin-top: 0.35rem;
}

.purelane-hero__price-line strong {
  color: var(--pl-surface);
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 2.3rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1;
}

.purelane-hero__price-line s {
  color: var(--pl-paper-soft);
  font-size: 1.2rem;
}

.purelane-hero__price-badge {
  display: inline-block;
  margin-top: 0.45rem;
  padding: 0.3rem 0.8rem;
  border: 1px solid rgba(240, 160, 60, 0.38);
  border-radius: 999px;
  background: rgba(240, 160, 60, 0.2);
  color: var(--pl-accent);
  font-size: 0.84rem;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.purelane-hero__dots {
  min-height: 28px;
  margin-top: 0.5rem;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.7rem;
}

.purelane-hero__dot {
  width: 6px;
  height: 6px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(236, 230, 247, 0.28);
  cursor: pointer;
  transition: all 0.4s var(--pl-ease);
}

.purelane-hero__dot.is-active {
  width: 20px;
  border-radius: 999px;
  background: var(--pl-accent);
}

.purelane-hero__dot:hover {
  background: rgba(236, 230, 247, 0.5);
}

@media screen and (max-width: 1200px) {
  .purelane-hero__inner {
    grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
  }

  .purelane-hero__copy {
    max-width: 470px;
  }
}

@media screen and (max-width: 900px) {
  .purelane-hero {
    min-height: auto;
  }

  .purelane-hero__background::after {
    background:
      linear-gradient(
        180deg,
        rgba(1, 45, 42, 0.44) 0%,
        rgba(1, 45, 42, 0.22) 34%,
        rgba(1, 40, 38, 0.6) 100%
      );
  }

  .purelane-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: min(100% - 28px, 620px);
    padding: 8.25rem 0 1.75rem;
    gap: 0;
  }

  .purelane-hero__copy {
    max-width: none;
  }

  .purelane-hero__desktop-promises {
    display: none;
  }

  .purelane-hero__mobile-promises {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .purelane-hero__mobile-promise {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.7rem 0.4rem;
    border: 1px solid rgba(236, 230, 247, 0.16);
    border-radius: 14px;
    text-align: center;
    background: rgba(236, 230, 247, 0.08);
    backdrop-filter: blur(14px);
    color: var(--pl-paper-muted);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.3;
