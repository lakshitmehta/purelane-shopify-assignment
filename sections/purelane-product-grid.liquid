<section
  class="purelane-product-grid"
  id="shop"
  style="
    --pl-grid-bg: {{ section.settings.background_color }};
    --pl-grid-text: {{ section.settings.text_color }};
    --pl-grid-accent: {{ section.settings.accent_color }};
  "
>
  <div class="purelane-product-grid__inner page-width">
    <div class="purelane-product-grid__header">
      {% if section.settings.eyebrow != blank %}
        <span class="purelane-product-grid__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {% endif %}

      <h2 class="purelane-product-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <div class="purelane-product-grid__description">
          {{ section.settings.description | escape }}
        </div>
      {% endif %}
    </div>

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      <div
        class="purelane-product-grid__grid"
        style="
          --pl-columns-desktop: {{ section.settings.columns_desktop }};
          --pl-columns-mobile: {{ section.settings.columns_mobile }};
        "
      >
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          {% render 'purelane-product-card',
            product: product,
            show_vendor: section.settings.show_vendor
          %}
        {% endfor %}
      </div>

      {% if section.settings.show_view_all and selected_collection.products_count > section.settings.products_to_show %}
        <div class="purelane-product-grid__footer">
          <a
            class="purelane-product-grid__view-all"
            href="{{ selected_collection.url }}"
          >
            {{ section.settings.view_all_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="purelane-product-grid__empty">
        <p>
          Select a collection in the theme editor to display products.
        </p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.purelane-product-grid {
  background: var(--pl-grid-bg);
  color: var(--pl-grid-text);
  padding-block: clamp(3.4rem, 6vw, 7rem);
}

.purelane-product-grid__inner {
  width: min(1180px, calc(100% - 36px));
  margin-inline: auto;
  padding-inline: 0;
}

.purelane-product-grid__header {
  max-width: 720px;
  margin-inline: auto;
  margin-bottom: 3.2rem;
  text-align: center;
}

.purelane-product-grid__eyebrow {
  display: block;
  margin-bottom: 0.8rem;
  color: var(--pl-grid-accent);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.purelane-product-grid__heading {
  margin: 0;
  color: var(--pl-grid-text);
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: clamp(3rem, 4.6vw, 5.4rem);
  font-weight: 800;
  line-height: 0.94;
  letter-spacing: -0.018em;
}

.purelane-product-grid__description {
  max-width: 58ch;
  margin: 1.2rem auto 0;
  color: rgba(23, 16, 43, 0.68);
  font-size: 1.5rem;
  line-height: 1.6;
}

.purelane-product-grid__grid {
  display: grid;
  grid-template-columns: repeat(var(--pl-columns-desktop), minmax(0, 1fr));
  gap: clamp(1.2rem, 2vw, 2.4rem);
}

.purelane-product-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid rgba(23, 16, 43, 0.08);
  border-radius: 22px;
  background: #faf7fd;
  box-shadow: 0 16px 40px rgba(23, 16, 43, 0.08);
}

.purelane-product-card__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #f0ebf7;
}

.purelane-product-card__media-link {
  display: block;
  width: 100%;
  height: 100%;
}

.purelane-product-card__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.35s ease;
}

.purelane-product-card:hover .purelane-product-card__media img {
  transform: scale(1.035);
}

.purelane-product-card__placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  padding: 2rem;
}

.purelane-product-card__placeholder-svg {
  width: 55%;
  height: 55%;
  opacity: 0.4;
}

.purelane-product-card__badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 2;
  padding: 0.45rem 0.85rem;
  border-radius: 999px;
  background: #4b3a8f;
  color: #fff;
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.purelane-product-card__content {
  padding: 1.5rem 1.5rem 1.7rem;
}

.purelane-product-card__vendor {
  margin: 0 0 0.4rem;
  color: rgba(23, 16, 43, 0.52);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.purelane-product-card__title {
  margin: 0;
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 1.8rem;
  font-weight: 700;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.purelane-product-card__title a {
  color: inherit;
  text-decoration: none;
}

.purelane-product-card__rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.8rem;
  color: #c9761d;
  font-size: 1.2rem;
}

.purelane-product-card__rating-text {
  color: rgba(23, 16, 43, 0.55);
  font-size: 1rem;
  font-weight: 700;
}

.purelane-product-card__pricing {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1rem;
}

.purelane-product-card__price {
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 2rem;
  font-weight: 800;
}

.purelane-product-card__compare {
  color: rgba(23, 16, 43, 0.42);
  font-size: 1.15rem;
}

.purelane-product-card__form {
  margin-top: 1.2rem;
}

.purelane-product-card__button {
  width: 100%;
  min-height: 4.6rem;
  border: 1px solid #4b3a8f;
  border-radius: 999px;
  background: #4b3a8f;
  color: #fff;
  font-family: inherit;
  font-size: 1.3rem;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

.purelane-product-card__button:hover:not(:disabled) {
  transform: translateY(-2px);
}

.purelane-product-card__button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.purelane-product-card__button:focus-visible,
.purelane-product-card__title a:focus-visible,
.purelane-product-card__media-link:focus-visible,
.purelane-product-grid__view-all:focus-visible {
  outline: 2px solid var(--pl-grid-accent);
  outline-offset: 3px;
}

.purelane-product-grid__footer {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
}

.purelane-product-grid__view-all {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  padding: 1rem 1.7rem;
  border: 1px solid rgba(23, 16, 43, 0.2);
  border-radius: 999px;
  color: var(--pl-grid-text);
  font-size: 1.3rem;
  font-weight: 800;
  text-decoration: none;
}

.purelane-product-grid__empty {
  padding: 4rem 2rem;
  border: 1px dashed rgba(23, 16, 43, 0.2);
  border-radius: 22px;
  text-align: center;
  color: rgba(23, 16, 43, 0.62);
}

@media screen and (max-width: 749px) {
  .purelane-product-grid__grid {
    grid-template-columns: repeat(var(--pl-columns-mobile), minmax(0, 1fr));
    gap: 1rem;
  }

  .purelane-product-card__content {
    padding: 1.2rem;
  }

  .purelane-product-card__title {
    font-size: 1.5rem;
  }

  .purelane-product-card__price {
    font-size: 1.7rem;
  }

  .purelane-product-card__button {
    min-height: 4.3rem;
    font-size: 1.2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .purelane-product-card__media img,
  .purelane-product-card__button {
    transition: none;
  }

  .purelane-product-card:hover .purelane-product-card__media img,
  .purelane-product-card__button:hover:not(:disabled) {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Product Grid",
  "tag": "section",
  "class": "purelane-product-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Purelane homecare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Plant-powered cleaning products made for everyday Indian homes."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "View all products"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ece6f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#17102b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c9761d"
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid",
      "category": "Purelane",
      "settings": {
        "collection": "all"
      }
    }
  ]
}
{% endschema %}