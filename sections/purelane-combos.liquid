<section
  id="combos"
  class="purelane-combos"
  style="
    --pl-combo-bg: {{ section.settings.background_color }};
    --pl-combo-text: {{ section.settings.text_color }};
    --pl-combo-accent: {{ section.settings.accent_color }};
  "
>
  <div class="purelane-combos__inner page-width">

    <header class="purelane-combos__header">
      {% if section.settings.eyebrow != blank %}
        <span class="purelane-combos__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {% endif %}

      <h2 class="purelane-combos__heading">
        {{ section.settings.heading | escape }}
      </h2>

      <div class="purelane-combos__rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="purelane-combos__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </header>

    <div class="purelane-combos__rail" tabindex="0" aria-label="Best selling combos">
      {% for block in section.blocks %}
        {% if block.type == 'combo' %}

          {% assign product_total = 0 %}

          {% for product in block.settings.products %}
            {% assign product_total = product_total | plus: product.price %}
          {% endfor %}

          {% assign bundle_price = block.settings.bundle_price | times: 100 %}
          {% assign savings = product_total | minus: bundle_price %}

          <article
            class="
              purelane-combo
              {% if block.settings.featured %}purelane-combo--featured{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            <div class="purelane-combo__visual">

              <div class="purelane-combo__badges">
                {% if block.settings.savings_label != blank and savings > 0 %}
                  <span class="purelane-combo__saving">
                    {{ block.settings.savings_label | escape }}
                    {{ savings | money }}
                  </span>
                {% endif %}

                {% if block.settings.badge != blank %}
                  <span class="purelane-combo__flag">
                    {{ block.settings.badge | escape }}
                  </span>
                {% endif %}
              </div>

              {% if block.settings.products != blank %}
                <div class="purelane-combo__products">
                  {% for product in block.settings.products limit: 5 %}
                    <div class="purelane-combo__product">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image
                          | image_url: width: 500
                          | image_tag:
                            loading: 'lazy',
                            widths: '180, 300, 500',
                            sizes: '(min-width: 990px) 120px, 28vw',
                            alt: product.featured_image.alt | default: product.title
                        }}
                      {% else %}
                        <div class="purelane-combo__product-placeholder">
                          {{ 'product-1' | placeholder_svg_tag }}
                        </div>
                      {% endif %}

                      <span class="purelane-combo__product-name">
                        {{ product.title | escape }}
                      </span>
                    </div>

                    {% unless forloop.last %}
                      <span class="purelane-combo__plus" aria-hidden="true">+</span>
                    {% endunless %}
                  {% endfor %}
                </div>
              {% else %}
                <div class="purelane-combo__empty">
                  Select products for this combo
                </div>
              {% endif %}
            </div>

            <div class="purelane-combo__body">
              <div class="purelane-combo__title-row">
                <h3 class="purelane-combo__title">
                  {{ block.settings.title | escape }}
                </h3>

                <span class="purelane-combo__count">
                  {{ block.settings.products.count }} products
                </span>
              </div>

              {% if block.settings.description != blank %}
                <p class="purelane-combo__copy">
                  {{ block.settings.description | escape }}
                </p>
              {% endif %}

              <div class="purelane-combo__pricing">
                {% if bundle_price > 0 %}
                  <strong>{{ bundle_price | money }}</strong>
                {% endif %}

                {% if product_total > bundle_price %}
                  <s>{{ product_total | money }}</s>
                  <em>Save {{ savings | money }}</em>
                {% endif %}
              </div>

              {% if section.settings.show_purchase_note %}
                <p class="purelane-combo__fine">
                  {{ section.settings.purchase_note | escape }}
                </p>
              {% endif %}

              {% if block.settings.cta_label != blank %}
                <a
                  class="
                    purelane-combo__button
                    {% if block.settings.featured %}
                      purelane-combo__button--primary
                    {% endif %}
                  "
                  href="{{ block.settings.cta_link | default: '#bundles' }}"
                >
                  {{ block.settings.cta_label | escape }}

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          </article>

        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_swipe_hint %}
      <p class="purelane-combos__swipe-hint" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h13m-5-6 6 6-6 6"/>
        </svg>
        {{ section.settings.swipe_hint | escape }}
      </p>
    {% endif %}

    {% if section.settings.bottom_note != blank %}
      <p class="purelane-combos__note">
        {{ section.settings.bottom_note | escape }}
      </p>
    {% endif %}

  </div>
</section>

{% stylesheet %}
.purelane-combos {
  background: var(--pl-combo-bg);
  color: var(--pl-combo-text);
  padding-block: clamp(3.5rem, 6vw, 7rem);
  overflow: hidden;
}

.purelane-combos__inner {
  width: min(1180px, calc(100% - 36px));
  margin-inline: auto;
  padding-inline: 0;
}

.purelane-combos__header {
  max-width: 760px;
  margin-inline: auto;
  margin-bottom: 2.8rem;
  text-align: center;
}

.purelane-combos__eyebrow {
  display: block;
  margin-bottom: 0.8rem;
  color: var(--pl-combo-accent);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.purelane-combos__heading {
  margin: 0;
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: clamp(3.2rem, 4.6vw, 5.4rem);
  font-weight: 800;
  line-height: 0.94;
  letter-spacing: -0.018em;
  text-transform: uppercase;
}

.purelane-combos__rule {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  max-width: 240px;
  margin: 1rem auto 0;
}

.purelane-combos__rule i {
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, transparent, rgba(23, 16, 43, 0.24));
}

.purelane-combos__rule i:first-child {
  background: linear-gradient(90deg, rgba(23, 16, 43, 0.24), transparent);
}

.purelane-combos__rule svg {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  color: var(--pl-combo-accent);
}

.purelane-combos__description {
  max-width: 62ch;
  margin: 1.2rem auto 0;
  color: rgba(23, 16, 43, 0.66);
  font-size: 1.5rem;
  line-height: 1.6;
}

.purelane-combos__rail {
  display: flex;
  gap: 1.4rem;
  overflow-x: auto;
  padding: 0.5rem 0.25rem 1.5rem;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
  -webkit-overflow-scrolling: touch;
}

.purelane-combos__rail:focus-visible {
  outline: 2px solid var(--pl-combo-accent);
  outline-offset: 4px;
}

.purelane-combo {
  flex: 0 0 min(365px, 82vw);
  scroll-snap-align: start;
  overflow: hidden;
  border: 1px solid rgba(23, 16, 43, 0.1);
  border-radius: 24px;
  background: #faf7fd;
  box-shadow: 0 18px 45px rgba(23, 16, 43, 0.1);
}

.purelane-combo--featured {
  border-color: rgba(75, 58, 143, 0.38);
  box-shadow: 0 24px 60px rgba(75, 58, 143, 0.18);
}

.purelane-combo__visual {
  position: relative;
  min-height: 235px;
  padding: 2rem 1.4rem 1.4rem;
  background:
    radial-gradient(circle at 50% 30%, rgba(75, 58, 143, 0.11), transparent 48%),
    #f0ebf7;
}

.purelane-combo__badges {
  position: absolute;
  top: 1rem;
  left: 1rem;
  right: 1rem;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.5rem;
}

.purelane-combo__saving,
.purelane-combo__flag {
  display: inline-flex;
  align-items: center;
  max-width: 70%;
  min-height: 2.8rem;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 800;
  line-height: 1.1;
}

.purelane-combo__saving {
  background: rgba(240, 160, 60, 0.16);
  border: 1px solid rgba(201, 118, 29, 0.3);
  color: #8b4b0e;
}

.purelane-combo__flag {
  background: #4b3a8f;
  color: #fff;
}

.purelane-combo__products {
  min-height: 195px;
  padding-top: 3rem;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0.35rem;
}

.purelane-combo__product {
  min-width: 0;
  flex: 1 1 0;
  max-width: 105px;
  text-align: center;
}

.purelane-combo__product img,
.purelane-combo__product-placeholder {
  display: block;
  width: 100%;
  height: 130px;
  object-fit: contain;
}

.purelane-combo__product-placeholder {
  padding: 1rem;
  opacity: 0.4;
}

.purelane-combo__product-name {
  display: block;
  margin-top: 0.4rem;
  color: rgba(23, 16, 43, 0.68);
  font-size: 0.86rem;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.purelane-combo__plus {
  flex: 0 0 auto;
  align-self: center;
  margin-bottom: 1rem;
  color: var(--pl-combo-accent);
  font-family: var(--font-heading-family, sans-serif);
  font-size: 2rem;
  font-weight: 700;
}

.purelane-combo__empty {
  min-height: 195px;
  display: grid;
  place-items: center;
  padding: 2rem;
  color: rgba(23, 16, 43, 0.5);
  text-align: center;
}

.purelane-combo__body {
  padding: 1.7rem 1.6rem 1.8rem;
}

.purelane-combo__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.purelane-combo__title {
  margin: 0;
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.05;
}

.purelane-combo__count {
  flex: 0 0 auto;
  padding-top: 0.3rem;
  color: rgba(23, 16, 43, 0.5);
  font-size: 1rem;
  font-weight: 700;
}

.purelane-combo__copy {
  margin: 0.9rem 0 0;
  color: rgba(23, 16, 43, 0.64);
  font-size: 1.3rem;
  line-height: 1.55;
}

.purelane-combo__pricing {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.25rem;
}

.purelane-combo__pricing strong {
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1;
}

.purelane-combo__pricing s {
  color: rgba(23, 16, 43, 0.42);
  font-size: 1.2rem;
}

.purelane-combo__pricing em {
  color: #9a5311;
  font-size: 1.15rem;
  font-style: normal;
  font-weight: 800;
}

.purelane-combo__fine {
  margin: 0.8rem 0 0;
  color: rgba(23, 16, 43, 0.45);
  font-size: 1rem;
}

.purelane-combo__button {
  width: 100%;
  min-height: 4.8rem;
  margin-top: 1.35rem;
  padding: 1rem 1.4rem;
  border: 1px solid rgba(75, 58, 143, 0.35);
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  background: transparent;
  color: #4b3a8f;
  font-size: 1.25rem;
  font-weight: 800;
  text-decoration: none;
  transition:
    transform 0.2s ease,
    background-color 0.2s ease;
}

.purelane-combo__button:hover {
  transform: translateY(-2px);
  background: rgba(75, 58, 143, 0.06);
}

.purelane-combo__button svg {
  width: 1.8rem;
  height: 1.8rem;
}

.purelane-combo__button--primary {
  border-color: #4b3a8f;
  background: #4b3a8f;
  color: #fff;
}

.purelane-combo__button:focus-visible {
  outline: 2px solid var(--pl-combo-accent);
  outline-offset: 3px;
}

.purelane-combos__swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  margin: 0.3rem 0 0;
  color: rgba(23, 16, 43, 0.48);
  font-size: 1rem;
  font-weight: 700;
}

.purelane-combos__swipe-hint svg {
  width: 1.5rem;
  height: 1.5rem;
}

.purelane-combos__note {
  max-width: 720px;
  margin: 1.2rem auto 0;
  color: rgba(23, 16, 43, 0.45);
  font-size: 1.05rem;
  line-height: 1.5;
  text-align: center;
}

@media screen and (min-width: 990px) {
  .purelane-combos__rail {
    overflow-x: visible;
  }

  .purelane-combo {
    flex-basis: 345px;
  }
}

@media screen and (max-width: 749px) {
  .purelane-combos__inner {
    width: min(100% - 28px, 620px);
  }

  .purelane-combos__rail {
    margin-inline: -0.4rem;
    padding-inline: 0.4rem;
  }

  .purelane-combo {
    flex-basis: min(330px, 82vw);
  }

  .purelane-combo__visual {
    min-height: 220px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .purelane-combo__button {
    transition: none;
  }

  .purelane-combo__button:hover {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "limit": 1,
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "checkbox",
      "id": "show_purchase_note",
      "label": "Show purchase note",
      "default": true
    },
    {
      "type": "text",
      "id": "purchase_note",
      "label": "Purchase note",
      "default": "Inclusive of all taxes · COD available"
    },
    {
      "type": "checkbox",
      "id": "show_swipe_hint",
      "label": "Show swipe hint",
      "default": true
    },
    {
      "type": "text",
      "id": "swipe_hint",
      "label": "Swipe hint",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "Choose a combo, then continue to the bundle builder."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ece6f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#17102b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c9761d"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Kitchen essentials"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 5
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Bundle price",
          "default": 499,
          "info": "Enter the bundle selling price in the store currency."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Everything you need for a sparkling kitchen, already grouped into one box."
        },
        {
          "type": "text",
          "id": "savings_label",
          "label": "Savings label",
          "default": "You save"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Most popular"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured combo",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "category": "Purelane",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}