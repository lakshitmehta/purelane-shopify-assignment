<section
  id="reviews"
  class="purelane-reviews"
  style="
    --pl-review-bg: {{ section.settings.background_color }};
    --pl-review-text: {{ section.settings.text_color }};
    --pl-review-accent: {{ section.settings.accent_color }};
  "
>
  <div class="purelane-reviews__inner page-width">

    <header class="purelane-reviews__header">
      {% if section.settings.eyebrow != blank %}
        <span class="purelane-reviews__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {% endif %}

      <div class="purelane-reviews__stats">
        {% if section.settings.rating_text != blank %}
          <span class="purelane-reviews__stat">
            <span class="purelane-reviews__stars" aria-hidden="true">★★★★★</span>
            {{ section.settings.rating_text | escape }}
          </span>
        {% endif %}

        {% if section.settings.customer_text != blank %}
          <span class="purelane-reviews__stat">
            {{ section.settings.customer_text | escape }}
          </span>
        {% endif %}
      </div>

      <h2 class="purelane-reviews__heading">
        {{ section.settings.heading | escape }}
      </h2>
    </header>

  </div>

  <div
    class="purelane-reviews__rail"
    tabindex="0"
    aria-label="{{ section.settings.rail_label | escape }}"
  >
    {% for block in section.blocks %}
      {% if block.type == 'review' %}
        <article
          class="purelane-review-card"
          {{ block.shopify_attributes }}
        >
          <div class="purelane-review-card__stars" aria-label="5 out of 5 stars">
            <span aria-hidden="true">★★★★★</span>
          </div>

          <h3 class="purelane-review-card__title">
            {{ block.settings.title | escape }}
          </h3>

          <p class="purelane-review-card__text">
            {{ block.settings.review | escape }}
          </p>

          <div class="purelane-review-card__person">
            <span class="purelane-review-card__check" aria-hidden="true">
              ✓
            </span>

            <strong>
              {{ block.settings.customer | escape }}
            </strong>

            {% if block.settings.product_name != blank %}
              <span>
                · {{ block.settings.product_name | escape }}
              </span>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.purelane-reviews {
  position: relative;
  overflow: hidden;
  padding-block: clamp(3.5rem, 6vw, 7rem);
  background: var(--pl-review-bg);
  color: var(--pl-review-text);
}

.purelane-reviews__inner {
  width: min(1180px, calc(100% - 36px));
  margin-inline: auto;
  padding-inline: 0;
}

.purelane-reviews__header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.2rem 2rem;
  margin-bottom: 2.6rem;
}

.purelane-reviews__eyebrow {
  color: var(--pl-review-accent);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.purelane-reviews__stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.9rem;
}

.purelane-reviews__stat {
  color: rgba(23, 16, 43, 0.62);
  font-size: 1.15rem;
  font-weight: 700;
}

.purelane-reviews__stars,
.purelane-review-card__stars {
  color: var(--pl-review-accent);
  letter-spacing: 0.08em;
}

.purelane-reviews__heading {
  width: 100%;
  margin: 0;
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: clamp(3rem, 5vw, 5.5rem);
  font-weight: 800;
  line-height: 0.94;
  letter-spacing: -0.018em;
  text-transform: uppercase;
}

.purelane-reviews__rail {
  display: flex;
  gap: 1.2rem;
  overflow-x: auto;
  padding: 0.5rem max(18px, calc((100vw - 1180px) / 2)) 1.5rem;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
  -webkit-overflow-scrolling: touch;
}

.purelane-reviews__rail:focus-visible {
  outline: 2px solid var(--pl-review-accent);
  outline-offset: 4px;
}

.purelane-review-card {
  flex: 0 0 min(365px, 82vw);
  min-height: 270px;
  padding: 1.8rem;
  scroll-snap-align: start;
  border: 1px solid rgba(23, 16, 43, 0.1);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(250, 247, 253, 0.98),
      rgba(238, 232, 247, 0.92)
    );
  box-shadow: 0 18px 45px rgba(23, 16, 43, 0.09);
}

.purelane-review-card__stars {
  font-size: 1.25rem;
}

.purelane-review-card__title {
  margin: 1rem 0 0;
  color: var(--pl-review-text);
  font-family: var(--font-heading-family, "Outfit", sans-serif);
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.05;
}

.purelane-review-card__text {
  margin: 1rem 0 0;
  color: rgba(23, 16, 43, 0.67);
  font-size: 1.3rem;
  line-height: 1.55;
}

.purelane-review-card__person {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: 1.5rem;
  color: rgba(23, 16, 43, 0.48);
  font-size: 1rem;
}

.purelane-review-card__person strong {
  color: var(--pl-review-text);
}

.purelane-review-card__check {
  width: 1.8rem;
  height: 1.8rem;
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  background: #4b3a8f;
  color: #fff;
  font-size: 1rem;
  font-weight: 800;
}

.purelane-review-card:focus-within {
  outline: 2px solid var(--pl-review-accent);
  outline-offset: 3px;
}

@media screen and (min-width: 990px) {
  .purelane-reviews__rail {
    padding-left: max(18px, calc((100vw - 1180px) / 2));
    padding-right: max(18px, calc((100vw - 1180px) / 2));
  }
}

@media screen and (max-width: 749px) {
  .purelane-reviews__inner {
    width: min(100% - 28px, 620px);
  }

  .purelane-reviews__header {
    display: block;
  }

  .purelane-reviews__stats {
    margin-top: 0.8rem;
  }

  .purelane-review-card {
    min-height: 250px;
    padding: 1.5rem;
  }

  .purelane-review-card__title {
    font-size: 1.8rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "limit": 1,
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
